<?xml version="1.0" encoding="utf-8"?>
<!-- Đã xóa xmlns:tools để sửa lỗi "Namespace declaration is never used" -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Khai báo quyền Camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Fix lỗi Permission exists without corresponding hardware -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentProfileManager">

        <!-- Màn hình chính (Launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình con EditProfileActivity[cite: 23] -->
        <activity
            android:name=".EditProfileActivity"
            android:exported="false" />
    </application>

</manifest>